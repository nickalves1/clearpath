APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,elasticsearch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

WWWUSER=1000
WWWGROUP=1000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Only needed when QUEUE_CONNECTION=sqs — see config/queue.php.
# SQS_PREFIX is your queue's URL up to (not including) the queue name,
# e.g. https://sqs.sa-east-1.amazonaws.com/<your-aws-account-id>
SQS_PREFIX=
SQS_QUEUE=clearpath-patient-events.fifo

# Only used when the "cloudwatch" channel is part of LOG_STACK — see
# config/logging.php and app/Logging/CloudWatchLoggerFactory.php.
CLOUDWATCH_LOG_GROUP=/clearpath/patients
CLOUDWATCH_LOG_STREAM=app
CLOUDWATCH_LOG_RETENTION_DAYS=14

# Only used when the "elasticsearch" channel is part of LOG_STACK — see
# config/logging.php and app/Logging/ElasticsearchLoggerFactory.php.
# Elasticsearch runs by default with `docker compose up -d`; Kibana (the
# viewer) is on-demand: `docker compose --profile kibana up -d kibana`
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=clearpath-patients

VITE_APP_NAME="${APP_NAME}"
